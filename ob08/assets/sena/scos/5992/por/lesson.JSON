nt": "very long."}], "id": 25, "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "SLS", "id": 10, "_data": [{"contents": [{"type": "text", "content": " How has banking technology changed over time?"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "text", "content": "Instructions: Select all the correct answers."}], "type": "post_instructions"}]}, {"questions": [{"id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le05ob08re2aud01", "images": [{"time": "0", "text": "", "id": 0, "image": "engenn7le05ob08re2img01.jpg"}, {"time": "100", "text": "<p>John Shepherd-Barron was an inventor who had a brilliant idea in 1965. Each weekend he had to visit the bank that opened between 9:30 and 12:30, and take out the money that he needed for the weekend. If he did not have enough time to do this, he was left without cash until the bank opened again.</p>He finally realized that many people had this problem. Taking an example from vending machines that sell snack food, he invented a machine that would give people money after they typed in a four-digit code number. The invention of the ATM is a key technological invention of recent times.", "id": 1, "image": "engenn7le05ob08re2img01.jpg"}, {"time": "38000", "text": "<p>In the past, people actually had to go to the bank during working hours and wait in line which was very frustrating. With the invention of the ATM, people can now get cash any time, even when they are traveling. As a result, people are rarely ever left without money.</p>Over time, the ATM has also become a tool for paying bills and transferring money. Therefore, the main advantages of ATMs are that they allow easy access to banking services and help save time.", "id": 2, "image": "engenn7le05ob08re2img02.jpg"}, {"time": "69500", "text": "However, ATMs are not perfect, and they do have some disadvantages. On one hand, they are not available everywhere and banks do charge fees for using them. On the other hand, these machines are so much more accessible than the bank that they are worth the price of the ATM service and the time needed to find a machine. And today they are so widespread that it is hard to go a few blocks anywhere in the world without finding an ATM.", "id": 3, "image": "engenn7le05ob08re2img02.jpg"}, {"time": "97500", "text": "In summary, there is no doubt the ATM has added far more benefits than problems to our lives. It is truly an example of great technology in action developed by someone whose goal was to improve our way of life.", "id": 4, "image": "engenn7le05ob08re2img03.jpg"}], "coverimg": "engenn7le05ob08re2img01.jpg"}}], "template_override": 1, "type": "audio", "title": "", "_data": [], "id": 1}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "text": "", "id": 0, "image": ""}], "video_src": "engenn7le05ob08re3vid01"}}], "template_override": 1, "type": "video", "title": "", "_data": [], "id": 2}], "id": 0}]}